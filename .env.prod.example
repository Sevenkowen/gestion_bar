# Copiá este archivo a .env en la Raspberry Pi antes de levantar el stack
# cp .env.prod.example .env

# Obligatorio — cambiá por una clave larga y aleatoria
JWT_SECRET=cambiar-por-clave-secreta-larga-minimo-32-caracteres

# URL desde donde acceden los celulares/notebooks (IP de la Pi)
# Ejemplo: http://192.168.1.50
CORS_ORIGINS=http://192.168.1.50

# Puerto web (80 = http://IP-de-la-Pi sin puerto)
WEB_PORT=80

# Base de datos (podés dejar estos valores)
POSTGRES_USER=sistemabar
POSTGRES_PASSWORD=sistemabar_secret
POSTGRES_DB=sistemabar

# Token más largo para demo con clientes (default 8h)
JWT_EXPIRES_IN=8h
