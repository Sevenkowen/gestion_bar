// SistemaBar — Schema Prisma MVP
// Documentación: docs/ARCHITECTURE.md

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum RoleName {
  ADMIN
  CAJA
  MOZO
}

enum TableStatus {
  LIBRE
  OCUPADA
  CUENTA_PEDIDA
  RESERVADA // futuro
}

enum OrderStatus {
  ABIERTO
  ENVIADO
  CUENTA_PEDIDA
  CERRADO
  CANCELADO
}

enum OrderItemStatus {
  BORRADOR
  ENVIADO
  EN_PREPARACION
  LISTO
  SERVIDO
  CANCELADO
}

enum OrderSource {
  SALON
  QR
  DELIVERY
  TAKEAWAY
}

enum OrderType {
  MESA
  DELIVERY
  RETIRO
}

enum PrintSector {
  COCINA
  BARRA
  NINGUNO
}

enum PrintJobStatus {
  PENDIENTE
  IMPRESO
  ERROR
}

enum PrintJobType {
  COMANDA_COCINA
  COMANDA_BARRA
  TICKET_CLIENTE
  TICKET_CAJA
}

enum StockMovementType {
  ENTRADA
  SALIDA
  AJUSTE
  VENTA
  ANULACION
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  TRANSFERENCIA
  OTRO
}

enum UnitType {
  UNIDAD
  GRAMO
  KILO
  ML
  LITRO
}

enum IngredientKind {
  COCINA
  BEBIDA
}

enum MenuItemType {
  PRODUCT
  COMBO
  INSUMO
}

// ─────────────────────────────────────────────────────────────
// MULTI-SUCURSAL (preparado, una sucursal en MVP)
// ─────────────────────────────────────────────────────────────

model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]
  tables    Table[]
  orders    Order[]
  printers  Printer[]
  products     Product[]
  categories   Category[]
  menuSections MenuSection[]
  menuItems    MenuItem[]

  @@map("branches")
}

// ─────────────────────────────────────────────────────────────
// AUTH & USUARIOS
// ─────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         RoleName @default(MOZO)
  active       Boolean  @default(true)
  branchId     Int      @map("branch_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  branch         Branch          @relation(fields: [branchId], references: [id])
  orders         Order[]         @relation("WaiterOrders")
  payments       Payment[]       @relation("CashierPayments")
  stockMovements StockMovement[]
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]

  @@index([branchId])
  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// MESAS
// ─────────────────────────────────────────────────────────────

model Table {
  id        Int         @id @default(autoincrement())
  number    Int
  name      String?
  capacity  Int         @default(4)
  status    TableStatus @default(LIBRE)
  zone      String?     // "Salón", "Terraza" — futuro layout
  posX      Int?        @map("pos_x")
  posY      Int?        @map("pos_y")
  branchId  Int         @map("branch_id")
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  branch Branch  @relation(fields: [branchId], references: [id])
  orders Order[]

  @@unique([branchId, number])
  @@index([branchId, status])
  @@map("tables")
}

// ─────────────────────────────────────────────────────────────
// CATEGORÍAS & PRODUCTOS
// ─────────────────────────────────────────────────────────────

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  image     String?
  active    Boolean  @default(true)
  branchId  Int      @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch   Branch    @relation(fields: [branchId], references: [id])
  products Product[]

  @@unique([branchId, name])
  @@map("categories")
}

model Product {
  id              Int         @id @default(autoincrement())
  name            String
  description     String?
  price           Decimal     @db.Decimal(10, 2)
  image           String?
  categoryId      Int         @map("category_id")
  printSector     PrintSector @default(COCINA) @map("print_sector")
  manualAvailable Boolean     @default(true) @map("manual_available")
  autoAvailable   Boolean     @default(true) @map("auto_available")
  active          Boolean     @default(true)
  branchId        Int         @map("branch_id")
  deletedAt       DateTime?   @map("deleted_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  category    Category            @relation(fields: [categoryId], references: [id])
  branch      Branch              @relation(fields: [branchId], references: [id])
  recipe      ProductIngredient[]
  comboItems  ComboProduct[]
  orderItems  OrderItem[]
  menuItems   MenuItem[]

  @@index([branchId, categoryId])
  @@index([branchId, active])
  @@map("products")
}

// ─────────────────────────────────────────────────────────────
// INGREDIENTES & RECETAS
// ─────────────────────────────────────────────────────────────

model Ingredient {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  kind         IngredientKind @default(COCINA)
  unit         UnitType       @default(UNIDAD)
  currentStock Decimal        @default(0) @map("current_stock") @db.Decimal(12, 4)
  minStock     Decimal        @default(0) @map("min_stock") @db.Decimal(12, 4)
  cost         Decimal        @default(0) @db.Decimal(10, 4)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  recipes    ProductIngredient[]
  movements  StockMovement[]
  menuItems  MenuItem[]
  orderItems OrderItem[]

  @@map("ingredients")
}

model ProductIngredient {
  id           Int     @id @default(autoincrement())
  productId    Int     @map("product_id")
  ingredientId Int     @map("ingredient_id")
  quantity     Decimal @db.Decimal(12, 4)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, ingredientId])
  @@map("product_ingredients")
}

// ─────────────────────────────────────────────────────────────
// COMBOS
// ─────────────────────────────────────────────────────────────

model Combo {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  image       String?
  active      Boolean  @default(true)
  branchId    Int      @map("branch_id")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products   ComboProduct[]
  orderItems OrderItem[]
  menuItems  MenuItem[]

  @@index([branchId, active])
  @@map("combos")
}

// ─────────────────────────────────────────────────────────────
// MENÚ (carta visible para mozos/clientes)
// ─────────────────────────────────────────────────────────────

model MenuSection {
  id        Int      @id @default(autoincrement())
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  branchId  Int      @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch     @relation(fields: [branchId], references: [id])
  items  MenuItem[]

  @@unique([branchId, name])
  @@map("menu_sections")
}

model MenuItem {
  id           Int          @id @default(autoincrement())
  sectionId    Int          @map("section_id")
  type         MenuItemType
  productId    Int?         @map("product_id")
  comboId      Int?         @map("combo_id")
  ingredientId Int?         @map("ingredient_id")
  price        Decimal      @db.Decimal(10, 2)
  sortOrder    Int          @default(0) @map("sort_order")
  visible      Boolean      @default(true)
  branchId     Int          @map("branch_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  section    MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id])
  combo      Combo?      @relation(fields: [comboId], references: [id])
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])
  branch     Branch      @relation(fields: [branchId], references: [id])

  @@index([sectionId, sortOrder])
  @@index([branchId, visible])
  @@map("menu_items")
}

model ComboProduct {
  id        Int     @id @default(autoincrement())
  comboId   Int     @map("combo_id")
  productId Int     @map("product_id")
  quantity  Int     @default(1)

  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([comboId, productId])
  @@map("combo_products")
}

// ─────────────────────────────────────────────────────────────
// PEDIDOS
// ─────────────────────────────────────────────────────────────

model Order {
  id        Int         @id @default(autoincrement())
  tableId   Int?        @map("table_id")
  status    OrderStatus @default(ABIERTO)
  source    OrderSource @default(SALON)
  type      OrderType   @default(MESA)
  waiterId  Int         @map("waiter_id")
  branchId  Int         @map("branch_id")
  subtotal  Decimal     @default(0) @db.Decimal(10, 2)
  total     Decimal     @default(0) @db.Decimal(10, 2)
  notes     String?
  version   Int         @default(1) // optimistic locking
  sentAt    DateTime?   @map("sent_at")
  closedAt  DateTime?   @map("closed_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  table      Table?      @relation(fields: [tableId], references: [id])
  waiter     User        @relation("WaiterOrders", fields: [waiterId], references: [id])
  branch     Branch      @relation(fields: [branchId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  printJobs  PrintJob[]

  @@index([tableId, status])
  @@index([branchId, status])
  @@index([branchId, createdAt])
  @@map("orders")
}

model OrderItem {
  id           Int             @id @default(autoincrement())
  orderId      Int             @map("order_id")
  productId    Int?            @map("product_id")
  comboId      Int?            @map("combo_id")
  ingredientId Int?            @map("ingredient_id")
  menuItemId   Int?            @map("menu_item_id")
  quantity     Int             @default(1)
  unitPrice    Decimal         @map("unit_price") @db.Decimal(10, 2)
  subtotal     Decimal         @db.Decimal(10, 2)
  status       OrderItemStatus @default(BORRADOR)
  printSector  PrintSector?    @map("print_sector")
  notes        String?
  sentAt       DateTime?       @map("sent_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id])
  combo      Combo?      @relation(fields: [comboId], references: [id])
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])
  printJobs  PrintJob[]

  @@index([orderId, status])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────
// STOCK — AUDITORÍA
// ─────────────────────────────────────────────────────────────

model StockMovement {
  id            Int               @id @default(autoincrement())
  ingredientId  Int               @map("ingredient_id")
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 4) // negativo = salida
  previousStock Decimal           @map("previous_stock") @db.Decimal(12, 4)
  newStock      Decimal           @map("new_stock") @db.Decimal(12, 4)
  referenceType String?           @map("reference_type") // "Order", "Manual"
  referenceId   Int?            @map("reference_id")
  userId        Int?              @map("user_id")
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])

  @@index([ingredientId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────
// CAJA
// ─────────────────────────────────────────────────────────────

model Payment {
  id         Int      @id @default(autoincrement())
  orderId    Int      @map("order_id")
  cashierId  Int      @map("cashier_id")
  total      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  order  Order          @relation(fields: [orderId], references: [id])
  cashier User          @relation("CashierPayments", fields: [cashierId], references: [id])
  lines  PaymentLine[]

  @@index([orderId])
  @@index([createdAt])
  @@map("payments")
}

model PaymentLine {
  id        Int           @id @default(autoincrement())
  paymentId Int           @map("payment_id")
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_lines")
}

// ─────────────────────────────────────────────────────────────
// IMPRESIÓN
// ─────────────────────────────────────────────────────────────

model Printer {
  id             Int         @id @default(autoincrement())
  name           String
  sector         PrintSector
  connectionType String      @default("network") @map("connection_type") // network | usb
  address        String      // IP:port o path USB
  active         Boolean     @default(true)
  branchId       Int         @map("branch_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  branch    Branch     @relation(fields: [branchId], references: [id])
  printJobs PrintJob[]

  @@map("printers")
}

model PrintJob {
  id           Int            @id @default(autoincrement())
  printerId    Int?           @map("printer_id")
  orderId      Int            @map("order_id")
  orderItemId  Int?           @map("order_item_id")
  type         PrintJobType
  sector       PrintSector
  content      Json           // payload estructurado del ticket
  status       PrintJobStatus @default(PENDIENTE)
  attempts     Int            @default(0)
  maxAttempts  Int            @default(3) @map("max_attempts")
  errorMessage String?        @map("error_message")
  printedAt    DateTime?      @map("printed_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  printer   Printer?   @relation(fields: [printerId], references: [id])
  order     Order      @relation(fields: [orderId], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])

  @@index([status, createdAt])
  @@index([orderId])
  @@map("print_jobs")
}

// ─────────────────────────────────────────────────────────────
// AUDITORÍA & CONFIG
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String
  entity     String
  entityId   Int?     @map("entity_id")
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemConfig {
  id        Int      @id @default(autoincrement())
  key       String
  value     Json
  branchId  Int?     @map("branch_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, branchId])
  @@map("system_config")
}

// ─────────────────────────────────────────────────────────────
// FUTURO: Cloud sync outbox (no usar en MVP)
// ─────────────────────────────────────────────────────────────

model SyncOutbox {
  id         Int      @id @default(autoincrement())
  entity     String
  entityId   Int      @map("entity_id")
  action     String   // CREATE | UPDATE | DELETE
  payload    Json
  synced     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([synced, createdAt])
  @@map("sync_outbox")
}
